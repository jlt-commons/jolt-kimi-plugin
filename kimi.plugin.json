{
  "name": "jolt-nrepl",
  "version": "0.2.0",
  "description": "Persistent Jolt nREPL evaluation, plus code navigation, syntax repair and refactors for Jolt/Clojure",
  "skills": "./skills/",
  "sessionStart": {
    "skill": "jolt-nrepl"
  },
  "interface": {
    "displayName": "Jolt nREPL",
    "shortDescription": "Evaluate, navigate and refactor Jolt/Clojure code"
  },
  "mcpServers": {
    "jolt-nrepl": {
      "command": "jolt",
      "args": ["-m", "jolt-nrepl-mcp.server"],
      "cwd": "./",
      "startupTimeoutMs": 120000,
      "toolTimeoutMs": 610000
    },
    "jolt-lsp": {
      "command": "jolt",
      "args": ["-m", "jolt-lsp.main", "mcp"],
      "cwd": "./",
      "startupTimeoutMs": 120000,
      "toolTimeoutMs": 300000
    }
  }
}
