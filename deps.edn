{:jolt/min-version "0.8.25"
 ;; The MCP servers are the installed jolt-nrepl-mcp and jolt-lsp binaries.
 ;; This file runs the smoke test and the hooks (the :hooks alias).
 :paths []
 :deps {jolt-lang/nrepl {:git/url "https://github.com/jolt-lang/nrepl"
                         :git/tag "v0.4.0"
                         :git/sha "16558b920864e5302a5c1433a78f977bbb64a9d1"}
        jolt-lang/time {:git/url "https://github.com/jolt-lang/time"
                        :git/sha "5104b050e331ff4fadd7488c958bf121ca5c91d9"}
        org.clojure/data.json {:mvn/version "2.5.0"}}
 :aliases {;; the Kimi hooks: bin/jolt-kimi-hook runs jolt-claude.kimi
           :hooks {:extra-deps {io.github.jlt-commons/jolt-claude-plugin
                                {:git/url "https://github.com/jlt-commons/jolt-claude-plugin"
                                 :git/sha "779b38b712c7c1120ced168fbacc138058ad145b"}}}
           :test {:extra-paths ["test"]
                  :main-opts ["-m" "kimi-plugin.smoke-test"]}}
 :tasks {test {:doc "start both MCP servers as Kimi would and drive them"
               :task (jolt "-M:test")}}}
